# OpenClaw Voice Loop Integration Configuration

# ============================================================================
# Integration Settings
# ============================================================================
ENABLE_INTEGRATION=true
ENABLE_BIDIRECTIONAL=false          # Future: Pause Mouth when Ears is transcribing

# ============================================================================
# Monitoring Configuration
# ============================================================================
MOUTH_STATUS_POLL_INTERVAL=0.1      # Poll every 100ms
MOUTH_STATUS_DEBOUNCE_MS=200        # 200ms debounce after speaking stops

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=                           # Optional: /var/log/openclaw/integration.log

# ============================================================================
# Performance Tuning
# ============================================================================
MAX_QUEUE_SIZE=10
PROCESSING_TIMEOUT=30.0

# ============================================================================
# Analytics (PostHog)
# ============================================================================
POSTHOG_API_KEY=                        # Your PostHog project API key
POSTHOG_HOST=https://app.posthog.com    # PostHog instance URL (default: cloud)
POSTHOG_DISABLED=false                  # Set to true to disable analytics
