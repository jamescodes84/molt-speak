# OpenClaw Mouth - Configuration Template
# Copy this file to .env and customize as needed

# =============================================================================
# Voice Configuration
# =============================================================================

# TTS voice identifier (default: en-US-ChristopherNeural)
# Common options:
#   - en-US-ChristopherNeural (male)
#   - en-US-AriaNeural (female)
#   - en-US-JennyNeural (female)
#   - en-US-GuyNeural (male)
#   - en-US-DavisNeural (male)
# List all: python3 main.py --list-voices
TTS_VOICE=en-US-ChristopherNeural

# Speech rate multiplier (0.5 to 2.0, default: 1.0)
# 0.5 = half speed, 2.0 = double speed
TTS_RATE=1.0

# Volume multiplier (0.0 to 1.0, default: 1.0)
TTS_VOLUME=1.0

# Pitch adjustment in Hz (-100 to +100, default: 0.0)
TTS_PITCH=0.0

# =============================================================================
# Input Configuration
# =============================================================================

# Path to input file to monitor (default: ~/.openclaw/speech_output.txt)
INPUT_FILE=

# How often to check file for changes in seconds (default: 0.1)
MONITOR_INTERVAL=0.1

# =============================================================================
# Audio Configuration
# =============================================================================

# Audio sample rate (default: 24000)
SAMPLE_RATE=24000

# Audio buffer size (default: 1024)
BUFFER_SIZE=1024

# =============================================================================
# Queue Configuration
# =============================================================================

# Maximum number of messages to queue (default: 10)
# Prevents memory issues with rapid message streams
MAX_QUEUE_SIZE=10

# =============================================================================
# Logging Configuration
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
# Use DEBUG for troubleshooting
LOG_LEVEL=INFO

# Optional: Path to log file (leave empty for stdout only)
# Example: /var/log/openclaw_mouth.log
LOG_FILE=

# =============================================================================
# Display Configuration
# =============================================================================

# How often to update terminal display in seconds (default: 0.05 = 20Hz)
DISPLAY_UPDATE_RATE=0.05

# Enable ANSI colors in terminal (true/false, default: true)
ENABLE_COLORS=true
