# OpenClaw Ears - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=                       # Optional: /var/log/openclaw/ears.log (empty = stdout only)

# ============================================================================
# Model Configuration
# ============================================================================
WHISPER_MODEL=tiny              # tiny, base, small, medium (tiny recommended for speed)
COMPUTE_TYPE=int8               # int8, float16, default (int8 recommended for CPU)

# ============================================================================
# Audio Configuration
# ============================================================================
SAMPLE_RATE=16000               # Audio sample rate in Hz
SPEECH_THRESHOLD=500            # Speech detection threshold (lower = more sensitive)
SEGMENT_DURATION=1.5            # Segment duration in seconds (lower = faster response)

# ============================================================================
# Performance Tuning
# ============================================================================
MAX_CONCURRENT_TRANSCRIPTIONS=3 # Maximum concurrent transcription operations
CPU_THREADS=4                   # CPU threads for Whisper inference

# ============================================================================
# TTS Configuration
# ============================================================================
ENABLE_TTS=true                 # Enable text-to-speech responses
TTS_VOICE=us_male               # us_male, us_female, uk_male, uk_female, etc.
TTS_RATE=+0%                    # Speech rate (-50% to +50%)
TTS_VOLUME=+0%                  # Volume (-50% to +50%)

# ============================================================================
# OpenClaw Integration
# ============================================================================
OPENCLAW_VOICE_DIR=~/.openclaw/voice  # Directory for voice files
ENABLE_HISTORY=true             # Enable transcription history logging

# ============================================================================
# Feature Flags
# ============================================================================
USE_CACHE=false                 # Enable result caching (future feature)
DEBUG_MODE=false                # Enable debug mode with verbose output
